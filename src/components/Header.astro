---
import ThemeToggle from './ThemeToggle.astro';
import LanguageToggle from './LanguageToggle.tsx';
---

<header
  class="fixed top-0 left-0 right-0 z-50 backdrop-blur-md border-b"
  style="background-color: color-mix(in srgb, var(--color-bg-primary) 82%, transparent); border-color: var(--color-border);"
>
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-14 items-center justify-between">
      <!-- Logo -->
      <a href="/" class="site-name">
        Facundo Cornejo<span style="color: var(--color-accent);">.</span>
      </a>

      <!-- El indice ES la navegacion: el header solo lleva CV y toggles. -->
      <nav class="flex items-center gap-1 sm:gap-2">
        <a
          href="/resume"
          class="nav-link text-sm font-medium transition-colors duration-200"
          data-i18n-key="nav.resume"
        >
          Currículum
        </a>
        <div
          class="flex items-center gap-1"
          style="border-left: 1px solid var(--color-border); padding-left: 0.75rem; margin-left: 0.5rem;"
        >
          <LanguageToggle client:load />
          <ThemeToggle />
        </div>
      </nav>
    </div>
  </div>
</header>

<style>
  .site-name {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: 0.005em;
    color: var(--color-text-primary);
  }

  .site-name:hover span {
    color: var(--color-accent-hover);
  }

  .nav-link {
    color: var(--color-text-secondary);
    padding: 0.375rem 0.5rem;
    border-radius: 0.375rem;
  }

  .nav-link:hover {
    color: var(--color-accent);
  }
</style>

<!-- i18n text swap for Astro-rendered elements -->
<script>
  import { ui } from '@i18n/ui';
  import type { Locale } from '@i18n/store';

  function updateTexts(locale: Locale) {
    const elements = document.querySelectorAll<HTMLElement>('header [data-i18n-key]');
    elements.forEach((el) => {
      const key = el.dataset.i18nKey as keyof (typeof ui)['es'];
      if (key && ui[locale]?.[key]) {
        el.textContent = ui[locale][key];
      }
    });
  }

  window.addEventListener('locale-change', ((e: CustomEvent<Locale>) => {
    updateTexts(e.detail);
  }) as EventListener);

  const initialLocale = (document.documentElement.lang || 'es') as Locale;
  updateTexts(initialLocale);
</script>
