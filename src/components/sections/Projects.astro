---
import { projects } from '@content/projects';

const visibleProjects = projects.filter((p) => p.visible !== false);
---

<section id="projects" class="py-24 px-4">
  <div class="mx-auto max-w-6xl">
    <p class="section-eyebrow" data-i18n-key="projects.eyebrow">01 — Trabajo seleccionado</p>
    <h2
      class="text-3xl sm:text-4xl font-bold mb-4"
      style="color: var(--color-text-primary);"
      data-i18n-key="projects.title"
    >
      Proyectos
    </h2>
    <p
      class="text-base mb-12"
      style="color: var(--color-text-muted);"
      data-i18n-key="projects.subtitle"
    >
      Productos reales, con usuarios reales. Esto es lo que construí.
    </p>

    <div class="grid gap-8 md:grid-cols-2">
      {visibleProjects.map((project, i) => (
        <article
          class:list={[
            'project-card scroll-fade group rounded-xl overflow-hidden relative',
            { 'md:col-span-2': project.featured },
          ]}
          style={`--stagger: ${i * 0.1}s;`}
        >
          {/* Accent line top */}
          <div class="accent-line" aria-hidden="true"></div>

          {/* Featured project: side-by-side on desktop */}
          <div class:list={[{ 'md:flex': project.featured }]}>
            {/* Image with dot pattern */}
            <div
              class:list={[
                'project-image-wrapper aspect-video overflow-hidden relative flex flex-col',
                project.featured ? 'md:w-1/2 md:aspect-auto md:min-h-full' : '',
              ]}
            >
              {/* Browser chrome */}
              <div class="browser-bar" aria-hidden="true">
                <span class="browser-dot"></span>
                <span class="browser-dot"></span>
                <span class="browser-dot"></span>
                <span class="browser-url"></span>
              </div>
              <div class="relative flex-1 overflow-hidden">
                <div class="dot-pattern absolute inset-0" aria-hidden="true"></div>
                <img
                  src={project.image}
                  alt={project.title.es}
                  class="w-full h-full object-cover relative z-[1] transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                  onerror="this.onerror=null;this.src='/images/placeholder.svg';"
                />
              </div>
            </div>

            {/* Content */}
            <div class:list={['p-6', project.featured ? 'md:w-1/2 md:flex md:flex-col md:justify-center' : '']}>
              {/* Title + featured badge */}
              <div class="flex items-center gap-2 mb-2">
                <h3 class="text-xl font-bold" style="color: var(--color-text-primary);">
                  <span data-locale-es>{project.title.es}</span>
                  <span data-locale-en class="hidden">{project.title.en}</span>
                </h3>
                {project.featured && (
                  <span class="featured-badge px-2 py-0.5 rounded-md text-[10px] font-mono font-bold uppercase tracking-widest shrink-0">
                    <span data-locale-es>Destacado</span>
                    <span data-locale-en class="hidden">Featured</span>
                  </span>
                )}
              </div>

              {/* Role */}
              <p class="text-xs mb-3" style="color: var(--color-text-muted);">
                <span class="font-mono font-semibold" style="color: var(--color-accent);" data-i18n-key="projects.role">Mi rol:</span>{' '}
                <span data-locale-es>{project.role.es}</span>
                <span data-locale-en class="hidden">{project.role.en}</span>
              </p>

              {/* Description */}
              <p class="text-sm leading-relaxed mb-4" style="color: var(--color-text-secondary);">
                <span data-locale-es>{project.description.es}</span>
                <span data-locale-en class="hidden">{project.description.en}</span>
              </p>

              {/* Highlights */}
              <div class="mb-5">
                <p
                  class="text-xs font-mono font-semibold uppercase tracking-wider mb-2"
                  style="color: var(--color-accent);"
                  data-i18n-key="projects.highlights"
                >
                  Destacados
                </p>
                <ul data-locale-es class="space-y-1.5">
                  {project.highlights.es.map((h) => (
                    <li class="text-sm flex items-start gap-2" style="color: var(--color-text-secondary);">
                      <span class="mt-0.5 shrink-0" style="color: var(--color-accent);">&#x2713;</span>
                      {h}
                    </li>
                  ))}
                </ul>
                <ul data-locale-en class="hidden space-y-1.5">
                  {project.highlights.en.map((h) => (
                    <li class="text-sm flex items-start gap-2" style="color: var(--color-text-secondary);">
                      <span class="mt-0.5 shrink-0" style="color: var(--color-accent);">&#x2713;</span>
                      {h}
                    </li>
                  ))}
                </ul>
              </div>

              {/* Separator */}
              <hr class="mb-4" style="border-color: var(--color-border);" />

              {/* Tech badges */}
              <div class="flex flex-wrap gap-1.5 mb-5">
                {project.stack.map((tech) => (
                  <span class="tech-badge">{tech}</span>
                ))}
              </div>

              {/* Links */}
              <div class="flex flex-wrap gap-3">
                {project.caseStudySlug && (
                  <a
                    href={`/projects/${project.caseStudySlug}`}
                    class="project-link-primary"
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                    <span data-locale-es>Ver case study</span>
                    <span data-locale-en class="hidden">Read case study</span>
                  </a>
                )}
                {project.github && (
                  <a
                    href={project.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="project-link-secondary"
                  >
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
                    </svg>
                    <span data-locale-es>Ver código</span>
                    <span data-locale-en class="hidden">View code</span>
                  </a>
                )}
                {project.demo && (
                  <a
                    href={project.demo}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="project-link-primary"
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                    <span data-locale-es>Ver demo</span>
                    <span data-locale-en class="hidden">View demo</span>
                  </a>
                )}
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  /* ---- Card base ---- */
  .project-card {
    background-color: var(--color-bg-card);
    border: 1px solid var(--color-border);
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease,
      border-color 0.3s ease;
  }

  /* ---- Accent line top ---- */
  .accent-line {
    height: 3px;
    background: linear-gradient(90deg, var(--color-accent), var(--color-accent-hover), transparent);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .project-card:hover .accent-line {
    opacity: 1;
  }

  /* ---- Glow hover ---- */
  .project-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-accent) !important;
    box-shadow:
      0 0 20px rgba(13, 148, 136, 0.12),
      0 0 40px rgba(13, 148, 136, 0.06),
      0 20px 40px -12px rgba(13, 148, 136, 0.1);
  }

  :root[data-theme='dark'] .project-card:hover {
    box-shadow:
      0 0 20px rgba(129, 140, 248, 0.12),
      0 0 40px rgba(129, 140, 248, 0.06),
      0 20px 40px -12px rgba(129, 140, 248, 0.1);
  }

  /* ---- Dot pattern on image area ---- */
  .project-image-wrapper {
    background-color: var(--color-bg-secondary);
  }

  .dot-pattern {
    background-image: radial-gradient(circle, var(--color-text-muted) 1px, transparent 1px);
    background-size: 16px 16px;
    opacity: 0.25;
  }

  /* ---- Featured badge ---- */
  .featured-badge {
    background-color: var(--color-accent);
    color: white;
  }

  /* ---- Tech badges ---- */
  .tech-badge {
    display: inline-block;
    padding: 0.25rem 0.625rem;
    border-radius: 0.375rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    background-color: var(--color-bg-secondary);
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease,
      transform 0.15s ease;
    cursor: default;
  }

  .tech-badge:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
    background-color: var(--color-accent-light);
    transform: translateY(-1px);
  }

  /* ---- Link buttons ---- */
  .project-link-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.5rem 1rem;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    transition:
      color 0.2s ease,
      border-color 0.2s ease,
      background-color 0.2s ease;
  }

  .project-link-secondary:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
    background-color: var(--color-accent-light);
  }

  .project-link-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.5rem 1rem;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    background-color: var(--color-accent);
    color: white;
    transition:
      background-color 0.2s ease,
      transform 0.15s ease;
  }

  .project-link-primary:hover {
    background-color: var(--color-accent-hover);
    transform: translateY(-1px);
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card:hover {
      transform: none;
    }

    .tech-badge:hover,
    .project-link-primary:hover {
      transform: none;
    }
  }
</style>

<script>
  import type { Locale } from '@i18n/store';
  import { ui } from '@i18n/ui';

  function updateProjectLocale(locale: Locale) {
    const esElements = document.querySelectorAll<HTMLElement>('#projects [data-locale-es]');
    const enElements = document.querySelectorAll<HTMLElement>('#projects [data-locale-en]');

    if (locale === 'en') {
      esElements.forEach((el) => el.classList.add('hidden'));
      enElements.forEach((el) => el.classList.remove('hidden'));
    } else {
      esElements.forEach((el) => el.classList.remove('hidden'));
      enElements.forEach((el) => el.classList.add('hidden'));
    }

    // Update UI strings with data-i18n-key
    const i18nElements = document.querySelectorAll<HTMLElement>('#projects [data-i18n-key]');
    i18nElements.forEach((el) => {
      const key = el.dataset.i18nKey as keyof (typeof ui)['es'];
      if (key && ui[locale]?.[key]) {
        const span = el.querySelector('span');
        if (span) {
          span.textContent = ui[locale][key];
        } else {
          el.textContent = ui[locale][key];
        }
      }
    });
  }

  // Intersection Observer for scroll animations
  function initScrollAnimations() {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (prefersReducedMotion) {
      document.querySelectorAll('.scroll-fade').forEach((el) => el.classList.add('visible'));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1 },
    );

    document.querySelectorAll('.scroll-fade').forEach((el) => observer.observe(el));
  }

  // Init
  const initialLocale = (document.documentElement.lang || 'es') as Locale;
  updateProjectLocale(initialLocale);
  initScrollAnimations();

  window.addEventListener('locale-change', ((e: CustomEvent<Locale>) => {
    updateProjectLocale(e.detail);
  }) as EventListener);
</script>
