---
import { projects, type IndexGroup } from '@content/projects';

const visibleProjects = projects.filter((p) => p.visible !== false);

const groups: { key: IndexGroup; heading: { es: string; en: string } }[] = [
  { key: 'produccion', heading: { es: 'En producción.', en: 'In production.' } },
  { key: 'camino', heading: { es: 'En camino.', en: 'In the works.' } },
  { key: 'capo', heading: { es: 'Abajo del capó.', en: 'Under the hood.' } },
];
---

<section id="projects" class="pt-16 sm:pt-20 px-4 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-3xl">
    {
      groups.map((group) => (
        <div class="idx-group scroll-fade">
          <h2 class="idx-heading">
            <span data-locale-es>{group.heading.es}</span>
            <span data-locale-en class="hidden">{group.heading.en}</span>
          </h2>
          <ul class="idx-list">
            {visibleProjects
              .filter((p) => p.indexGroup === group.key)
              .map((project) => (
                <li data-peek={project.media?.[0]?.src}>
                  <span class="idx-year">{project.year}</span>
                  <span class="idx-what">
                    <a class="idx-title" href={`/projects/${project.caseStudySlug}`}>
                      <span data-locale-es>{project.title.es}</span>
                      <span data-locale-en class="hidden">{project.title.en}</span>
                    </a>
                    <span class="idx-sep">:</span>{' '}
                    <span class="idx-blurb">
                      <span data-locale-es>{project.description.es}</span>
                      <span data-locale-en class="hidden">{project.description.en}</span>
                    </span>
                    {project.status && (
                      <span class="idx-status">
                        {' — '}
                        <span data-locale-es>{project.status.es}</span>
                        <span data-locale-en class="hidden">{project.status.en}</span>
                      </span>
                    )}
                    {project.demo && (
                      <a
                        class="idx-live"
                        href={project.demo}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        <span data-locale-es>en vivo ↗</span>
                        <span data-locale-en class="hidden">live ↗</span>
                      </a>
                    )}
                    {project.media?.[0] && (
                      <img
                        class="idx-thumb"
                        src={project.media[0].src}
                        alt={project.media[0].alt.es}
                        loading="lazy"
                        decoding="async"
                      />
                    )}
                  </span>
                </li>
              ))}
            {group.key === 'capo' && (
              <li>
                <span class="idx-year">
                  <span data-locale-es>siempre</span>
                  <span data-locale-en class="hidden">always</span>
                </span>
                <span class="idx-what">
                  <span class="idx-title-plain">
                    <span data-locale-es>Stack de cabecera</span>
                    <span data-locale-en class="hidden">Daily stack</span>
                  </span>
                  <span class="idx-sep">:</span>{' '}
                  <span class="idx-blurb">
                    TypeScript, React/Next.js, Astro, Go, Node, PostgreSQL,
                    Supabase, Docker.
                  </span>
                </span>
              </li>
            )}
          </ul>
        </div>
      ))
    }
  </div>

  {/* Preview flotante para desktop (se oculta en touch/pantallas angostas) */}
  <div class="idx-peek" aria-hidden="true"><img src="" alt="" /></div>
</section>

<style>
  .idx-group {
    margin-top: 3.5rem;
  }

  .idx-heading {
    font-size: 1.5rem;
    font-style: italic;
    font-weight: 600;
    color: var(--color-accent);
    margin-bottom: 1.125rem;
  }

  .idx-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.875rem;
  }

  .idx-list li {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr);
    gap: 1.25rem;
    align-items: baseline;
  }

  .idx-year {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .idx-what {
    max-width: 62ch;
    line-height: 1.65;
  }

  .idx-title {
    font-weight: 600;
    color: var(--color-text-primary);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-accent) 55%, transparent);
    text-underline-offset: 3px;
    transition: color 0.15s ease;
  }

  .idx-title:hover {
    color: var(--color-accent);
  }

  .idx-title-plain {
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .idx-sep {
    color: var(--color-text-muted);
  }

  .idx-blurb {
    color: var(--color-text-secondary);
  }

  .idx-status {
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  .idx-live {
    margin-left: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-accent);
    text-decoration: none;
    white-space: nowrap;
  }

  .idx-live:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Miniatura mobile: el indice no puede ser puro texto en el celular. */
  .idx-thumb {
    display: none;
  }

  @media (max-width: 639px) {
    .idx-list li {
      grid-template-columns: 1fr;
      gap: 0.125rem;
    }

    .idx-year {
      text-align: left;
      font-size: 0.75rem;
    }

    .idx-thumb {
      display: block;
      width: 100%;
      max-width: 22rem;
      height: auto;
      margin-top: 0.625rem;
      border: 1px solid var(--color-border);
      border-radius: 0.5rem;
    }
  }

  /* Preview flotante (solo pointer fino y pantallas anchas) */
  .idx-peek {
    position: fixed;
    right: 1.75rem;
    top: 50%;
    transform: translateY(-50%) rotate(1.2deg) scale(0.98);
    width: min(28vw, 360px);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    overflow: hidden;
    background: var(--color-bg-card);
    box-shadow: 0 24px 60px -18px rgba(0, 0, 0, 0.55);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.22s ease, transform 0.22s ease;
    z-index: 30;
  }

  .idx-peek.on {
    opacity: 1;
    transform: translateY(-50%) rotate(0deg) scale(1);
  }

  .idx-peek img {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (max-width: 1180px), (pointer: coarse) {
    .idx-peek {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .idx-peek {
      transition: none;
      transform: translateY(-50%);
    }
  }
</style>

<script>
  import type { Locale } from '@i18n/store';

  function updateProjectLocale(locale: Locale) {
    const esElements = document.querySelectorAll<HTMLElement>(
      '#projects [data-locale-es]',
    );
    const enElements = document.querySelectorAll<HTMLElement>(
      '#projects [data-locale-en]',
    );

    if (locale === 'en') {
      esElements.forEach((el) => el.classList.add('hidden'));
      enElements.forEach((el) => el.classList.remove('hidden'));
    } else {
      esElements.forEach((el) => el.classList.remove('hidden'));
      enElements.forEach((el) => el.classList.add('hidden'));
    }
  }

  const initialLocale = (document.documentElement.lang || 'es') as Locale;
  updateProjectLocale(initialLocale);

  window.addEventListener('locale-change', ((e: CustomEvent<Locale>) => {
    updateProjectLocale(e.detail);
  }) as EventListener);

  // Hover preview: la captura del proyecto flota al margen derecho.
  const peek = document.querySelector<HTMLElement>('.idx-peek');
  const peekImg = peek?.querySelector('img');
  if (peek && peekImg) {
    let hideTimer = 0;
    document
      .querySelectorAll<HTMLElement>('#projects li[data-peek]')
      .forEach((li) => {
        if (!li.dataset.peek) return;
        li.addEventListener('mouseenter', () => {
          window.clearTimeout(hideTimer);
          peekImg.src = li.dataset.peek ?? '';
          peek.classList.add('on');
        });
        li.addEventListener('mouseleave', () => {
          hideTimer = window.setTimeout(() => peek.classList.remove('on'), 80);
        });
      });
  }
</script>
