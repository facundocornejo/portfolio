---
const stack = [
  { name: 'TypeScript', icon: 'typescript' },
  { name: 'React', icon: 'react' },
  { name: 'Next.js', icon: 'nextdotjs' },
  { name: 'Angular 18', icon: 'angular' },
  { name: 'Node.js', icon: 'nodedotjs' },
  { name: 'Express', icon: 'express' },
  { name: 'C# / .NET', icon: 'dotnet' },
  { name: 'Python', icon: 'python' },
  { name: 'PostgreSQL', icon: 'postgresql' },
  { name: 'Supabase', icon: 'supabase' },
  { name: 'Prisma', icon: 'prisma' },
  { name: 'Tailwind CSS', icon: 'tailwindcss' },
  { name: 'Docker', icon: 'docker' },
  { name: 'Git', icon: 'git' },
];

const aiTools = [
  { name: 'Claude Code', icon: 'claude' },
  { name: 'Cursor', icon: 'cursor' },
  { name: 'Gemini CLI', icon: 'gemini' },
];
---

<section id="about" class="py-24 px-4" style="background-color: var(--color-bg-secondary);">
  <div class="mx-auto max-w-5xl">
    <h2
      class="text-3xl sm:text-4xl font-bold mb-4 scroll-fade"
      style="color: var(--color-text-primary);"
      data-i18n-key="about.title"
    >
      Sobre mí
    </h2>
    <p
      class="text-base mb-12 scroll-fade"
      style="color: var(--color-text-muted); --stagger: 0.05s;"
      data-i18n-key="about.subtitle"
    >
      Quién soy y cómo trabajo.
    </p>

    <div class="grid md:grid-cols-5 gap-10 md:gap-12">
      {/* Bio — 3 cols */}
      <div class="md:col-span-3 space-y-5 scroll-fade" style="--stagger: 0.1s;">
        <p class="text-base leading-relaxed" style="color: var(--color-text-secondary);">
          <span data-locale-es>
            Soy Facundo, desarrollador fullstack de Paraná, Argentina. Me recibí de la Tecnicatura en Programación en la UTN y desde entonces vengo construyendo productos digitales — desde ERPs con inteligencia artificial hasta bots que monitorean precios de vuelos.
          </span>
          <span data-locale-en class="hidden">
            I'm Facundo, a fullstack developer from Paraná, Argentina. I graduated from UTN's Programming degree and since then I've been building digital products — from ERPs with artificial intelligence to bots that monitor flight prices.
          </span>
        </p>
        <p class="text-base leading-relaxed" style="color: var(--color-text-secondary);">
          <span data-locale-es>
            Trabajé en equipo en Lindigo (proyecto Azopardo, Angular v18), hago freelance para clientes locales y remotos, y me apasiona resolver problemas reales con código limpio. Me destaco en el relevamiento funcional: traduzco necesidades operativas en soluciones técnicas. No me quedo con lo que sé — siempre estoy explorando tecnologías nuevas.
          </span>
          <span data-locale-en class="hidden">
            I've worked in a team at Lindigo (Azopardo project, Angular v18), I freelance for local and remote clients, and I'm passionate about solving real problems with clean code. I excel at functional analysis: I translate operational needs into technical solutions. I don't settle for what I know — I'm always exploring new technologies.
          </span>
        </p>
        <p class="text-base leading-relaxed" style="color: var(--color-text-secondary);">
          <span data-locale-es>
            Mi diferencial: integro herramientas de IA en mi workflow de desarrollo. No como reemplazo, sino como multiplicador. Claude Code, Cursor, APIs de Gemini — uso todo lo que me haga más productivo y me permita entregar mejores resultados.
          </span>
          <span data-locale-en class="hidden">
            My edge: I integrate AI tools into my development workflow. Not as a replacement, but as a multiplier. Claude Code, Cursor, Gemini APIs — I use everything that makes me more productive and lets me deliver better results.
          </span>
        </p>

        {/* AI tools */}
        <div class="pt-2">
          <p class="text-xs font-mono font-semibold uppercase tracking-wider mb-3" style="color: var(--color-accent);">
            <span data-locale-es>Herramientas AI</span>
            <span data-locale-en class="hidden">AI Tools</span>
          </p>
          <div class="flex flex-wrap gap-2">
            {aiTools.map((tool) => (
              <span class="about-badge">
                {tool.name}
              </span>
            ))}
          </div>
        </div>
      </div>

      {/* Stack — 2 cols */}
      <div class="md:col-span-2 scroll-fade" style="--stagger: 0.2s;">
        <p
          class="text-xs font-mono font-semibold uppercase tracking-wider mb-4"
          style="color: var(--color-accent);"
          data-i18n-key="about.stack"
        >
          Stack
        </p>
        <div class="grid grid-cols-2 gap-2">
          {stack.map((tech) => (
            <div class="stack-item">
              <img
                src={`https://cdn.simpleicons.org/${tech.icon}`}
                alt={tech.name}
                width="18"
                height="18"
                loading="lazy"
                class="stack-icon"
              />
              <span class="text-sm">{tech.name}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about-badge {
    display: inline-block;
    padding: 0.3rem 0.75rem;
    border-radius: 0.375rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    border: 1px solid var(--color-accent);
    color: var(--color-accent);
    background-color: transparent;
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      transform 0.15s ease;
    cursor: default;
  }

  .about-badge:hover {
    background-color: var(--color-accent);
    color: white;
    transform: translateY(-1px);
  }

  .stack-item {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.5rem 0.75rem;
    border-radius: 0.5rem;
    border: 1px solid var(--color-border);
    background-color: var(--color-bg-card);
    color: var(--color-text-secondary);
    transition:
      border-color 0.2s ease,
      color 0.2s ease,
      transform 0.15s ease;
    cursor: default;
  }

  .stack-item:hover {
    border-color: var(--color-accent);
    color: var(--color-text-primary);
    transform: translateY(-2px);
  }

  .stack-icon {
    opacity: 0.7;
    transition: opacity 0.2s ease;
    filter: grayscale(100%);
  }

  .stack-item:hover .stack-icon {
    opacity: 1;
    filter: grayscale(0%);
  }

  @media (prefers-reduced-motion: reduce) {
    .about-badge:hover,
    .stack-item:hover {
      transform: none;
    }
  }
</style>

<script>
  import type { Locale } from '@i18n/store';
  import { ui } from '@i18n/ui';

  function updateAboutLocale(locale: Locale) {
    const esElements = document.querySelectorAll<HTMLElement>('#about [data-locale-es]');
    const enElements = document.querySelectorAll<HTMLElement>('#about [data-locale-en]');

    if (locale === 'en') {
      esElements.forEach((el) => el.classList.add('hidden'));
      enElements.forEach((el) => el.classList.remove('hidden'));
    } else {
      esElements.forEach((el) => el.classList.remove('hidden'));
      enElements.forEach((el) => el.classList.add('hidden'));
    }

    const i18nElements = document.querySelectorAll<HTMLElement>('#about [data-i18n-key]');
    i18nElements.forEach((el) => {
      const key = el.dataset.i18nKey as keyof (typeof ui)['es'];
      if (key && ui[locale]?.[key]) {
        el.textContent = ui[locale][key];
      }
    });
  }

  const initialLocale = (document.documentElement.lang || 'es') as Locale;
  updateAboutLocale(initialLocale);

  window.addEventListener('locale-change', ((e: CustomEvent<Locale>) => {
    updateAboutLocale(e.detail);
  }) as EventListener);
</script>
