---

<section id="workflow" class="pt-16 sm:pt-20 px-4 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-3xl how-wrap scroll-fade">
    <h2 class="how-heading">
      <span data-locale-es>Cómo trabajo.</span>
      <span data-locale-en class="hidden">How I work.</span>
    </h2>
    <ul class="how-list">
      <li>
        <span data-locale-es>
          <strong>El criterio es humano.</strong> Trabajo con IA todos los días
          — Claude Code, Codex, Gemini CLI, Whisper — pero la arquitectura y las
          decisiones son mías. Certificación
          <a href="https://verify.skilljar.com/c/49obzdit65bo" target="_blank" rel="noopener noreferrer">Claude Code in Action</a>
          (Anthropic, 2026).
        </span>
        <span data-locale-en class="hidden">
          <strong>Judgment stays human.</strong> I work with AI every day —
          Claude Code, Codex, Gemini CLI, Whisper — but the architecture and the
          decisions are mine. Certified:
          <a href="https://verify.skilljar.com/c/49obzdit65bo" target="_blank" rel="noopener noreferrer">Claude Code in Action</a>
          (Anthropic, 2026).
        </span>
      </li>
      <li>
        <span data-locale-es>
          <strong>Relevar antes de programar.</strong> Cada sistema salió de
          escuchar una operación real: qué se anota a mano, qué se pierde, qué
          duele.
        </span>
        <span data-locale-en class="hidden">
          <strong>Discovery before code.</strong> Every system came out of
          listening to a real operation: what gets written by hand, what gets
          lost, what hurts.
        </span>
      </li>
      <li>
        <span data-locale-es>
          <strong>Entregado es verificado.</strong> Nada se marca listo sin
          correr contra el sistema real. Los mocks no atienden mostradores.
        </span>
        <span data-locale-en class="hidden">
          <strong>Shipped means verified.</strong> Nothing gets marked done
          without running against the real system. Mocks don't run shop
          counters.
        </span>
      </li>
    </ul>
  </div>
</section>

<style>
  .how-wrap {
    border-top: 1px solid var(--color-border);
    padding-top: 2.5rem;
  }

  .how-heading {
    font-size: 1.5rem;
    font-style: italic;
    font-weight: 600;
    color: var(--color-accent);
    margin-bottom: 1.125rem;
  }

  .how-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.875rem;
    max-width: 62ch;
    color: var(--color-text-secondary);
    line-height: 1.7;
  }

  .how-list strong {
    color: var(--color-text-primary);
    font-weight: 600;
  }

  .how-list a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: color-mix(in srgb, var(--color-accent) 45%, transparent);
  }

  .how-list a:hover {
    text-decoration-color: var(--color-accent);
  }
</style>

<script>
  import type { Locale } from '@i18n/store';

  function updateWorkflowLocale(locale: Locale) {
    const esElements = document.querySelectorAll<HTMLElement>('#workflow [data-locale-es]');
    const enElements = document.querySelectorAll<HTMLElement>('#workflow [data-locale-en]');

    if (locale === 'en') {
      esElements.forEach((el) => el.classList.add('hidden'));
      enElements.forEach((el) => el.classList.remove('hidden'));
    } else {
      esElements.forEach((el) => el.classList.remove('hidden'));
      enElements.forEach((el) => el.classList.add('hidden'));
    }
  }

  const initialLocale = (document.documentElement.lang || 'es') as Locale;
  updateWorkflowLocale(initialLocale);

  window.addEventListener('locale-change', ((e: CustomEvent<Locale>) => {
    updateWorkflowLocale(e.detail);
  }) as EventListener);
</script>
