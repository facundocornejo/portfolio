---
---

<section id="contact" class="py-24 px-4">
  <div class="mx-auto max-w-2xl text-center">
    <p class="section-eyebrow scroll-fade" data-i18n-key="contact.eyebrow">04 — Hablemos</p>
    <h2
      class="text-3xl sm:text-4xl font-bold mb-4 scroll-fade"
      style="color: var(--color-text-primary);"
      data-i18n-key="contact.title"
    >
      Contacto
    </h2>
    <p
      class="text-base mb-10 scroll-fade"
      style="color: var(--color-text-muted); --stagger: 0.05s;"
      data-i18n-key="contact.subtitle"
    >
      Si lo que viste te sirve, hablemos. Respondo en menos de 24h.
    </p>

    {/* Contact form (Netlify Forms) */}
    <form
      name="contacto"
      method="POST"
      data-netlify="true"
      netlify-honeypot="bot-field"
      id="contact-form"
      class="contact-form scroll-fade text-left mb-10"
      style="--stagger: 0.08s;"
    >
      <input type="hidden" name="form-name" value="contacto" />
      {/* Honeypot field — hidden from humans */}
      <p class="hidden" aria-hidden="true">
        <label>No llenar: <input name="bot-field" /></label>
      </p>

      <div class="form-field">
        <label for="cf-name" class="form-label" data-i18n-key="contact.form.name">Nombre</label>
        <input
          type="text"
          name="name"
          id="cf-name"
          required
          autocomplete="name"
          class="form-input"
          data-i18n-placeholder="contact.form.name"
          placeholder="Nombre"
        />
      </div>

      <div class="form-field">
        <label for="cf-email" class="form-label" data-i18n-key="contact.form.email">Email</label>
        <input
          type="email"
          name="email"
          id="cf-email"
          required
          autocomplete="email"
          class="form-input"
          placeholder="tu@email.com"
        />
      </div>

      <div class="form-field">
        <label for="cf-message" class="form-label" data-i18n-key="contact.form.message">Mensaje</label>
        <textarea
          name="message"
          id="cf-message"
          required
          rows="5"
          class="form-input"
          data-i18n-placeholder="contact.form.message"
          placeholder="Mensaje"
        ></textarea>
      </div>

      <button type="submit" class="contact-submit" id="contact-submit">
        <span class="submit-text" data-i18n-key="contact.form.send">Enviar mensaje</span>
      </button>

      <p
        class="form-status hidden"
        id="form-status"
        role="status"
        aria-live="polite"
      ></p>
    </form>

    {/* Divider */}
    <div class="flex items-center gap-4 mb-10 scroll-fade" style="--stagger: 0.1s;">
      <hr class="flex-1" style="border-color: var(--color-border);" />
      <span
        class="text-xs font-mono uppercase tracking-wider"
        style="color: var(--color-text-muted);"
        data-i18n-key="contact.or"
      >
        O encontrame en
      </span>
      <hr class="flex-1" style="border-color: var(--color-border);" />
    </div>

    {/* Email CTA */}
    <div class="scroll-fade mb-10" style="--stagger: 0.1s;">
      <button
        type="button"
        class="contact-email-btn"
        id="copy-email-btn"
        data-email="facundocornejodediego@gmail.com"
      >
        <svg class="w-5 h-5 icon-mail" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        <svg class="w-5 h-5 icon-check hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        <span class="btn-text">facundocornejodediego@gmail.com</span>
      </button>
    </div>

    {/* Social links */}
    <div class="flex justify-center gap-4 scroll-fade" style="--stagger: 0.2s;">
      <a
        href="https://github.com/facundocornejo"
        target="_blank"
        rel="noopener noreferrer"
        class="contact-social"
        aria-label="GitHub"
      >
        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
        </svg>
        <span>GitHub</span>
      </a>

      <a
        href="https://www.linkedin.com/in/facundocornejo/"
        target="_blank"
        rel="noopener noreferrer"
        class="contact-social"
        aria-label="LinkedIn"
      >
        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
        </svg>
        <span>LinkedIn</span>
      </a>
    </div>
  </div>
</section>

<style>
  .contact-email-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 2rem;
    border-radius: 0.75rem;
    font-size: 0.875rem;
    font-weight: 500;
    font-family: var(--font-mono);
    background-color: var(--color-accent);
    color: white;
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      transform 0.15s ease,
      box-shadow 0.2s ease;
  }

  .contact-email-btn:hover {
    background-color: var(--color-accent-hover);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -4px var(--color-accent);
  }

  .contact-social {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 1.25rem 2rem;
    border-radius: 0.75rem;
    border: 1px solid var(--color-border);
    background-color: var(--color-bg-card);
    color: var(--color-text-secondary);
    font-size: 0.875rem;
    font-weight: 500;
    transition:
      border-color 0.2s ease,
      color 0.2s ease,
      transform 0.15s ease,
      background-color 0.2s ease;
    min-width: 120px;
  }

  .contact-social:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    transform: translateY(-3px);
    background-color: var(--color-accent-light);
  }

  /* ---- Contact form ---- */
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.125rem;
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .form-label {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
  }

  .form-input {
    width: 100%;
    padding: 0.75rem 1rem;
    border-radius: 0.625rem;
    border: 1px solid var(--color-border);
    background-color: var(--color-bg-card);
    color: var(--color-text-primary);
    font-size: 0.9375rem;
    font-family: inherit;
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .form-input::placeholder {
    color: var(--color-text-muted);
    opacity: 0.6;
  }

  .form-input:focus {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-accent) 18%, transparent);
  }

  textarea.form-input {
    resize: vertical;
    min-height: 7rem;
  }

  .contact-submit {
    align-self: flex-start;
    padding: 0.75rem 1.75rem;
    border-radius: 0.625rem;
    font-size: 0.9375rem;
    font-weight: 500;
    background-color: var(--color-accent);
    color: white;
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      transform 0.15s ease,
      opacity 0.2s ease;
  }

  .contact-submit:hover {
    background-color: var(--color-accent-hover);
    transform: translateY(-2px);
  }

  .contact-submit:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
  }

  .form-status {
    font-size: 0.875rem;
    margin-top: 0.25rem;
  }

  .form-status.is-success {
    color: var(--color-accent);
  }

  .form-status.is-error {
    color: #ef4444;
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-email-btn:hover,
    .contact-social:hover,
    .contact-submit:hover {
      transform: none;
    }
  }
</style>

<script>
  import type { Locale } from '@i18n/store';
  import { ui } from '@i18n/ui';

  function updateContactLocale(locale: Locale) {
    const esElements = document.querySelectorAll<HTMLElement>('#contact [data-locale-es]');
    const enElements = document.querySelectorAll<HTMLElement>('#contact [data-locale-en]');

    if (locale === 'en') {
      esElements.forEach((el) => el.classList.add('hidden'));
      enElements.forEach((el) => el.classList.remove('hidden'));
    } else {
      esElements.forEach((el) => el.classList.remove('hidden'));
      enElements.forEach((el) => el.classList.add('hidden'));
    }

    const i18nElements = document.querySelectorAll<HTMLElement>('#contact [data-i18n-key]');
    i18nElements.forEach((el) => {
      const key = el.dataset.i18nKey as keyof (typeof ui)['es'];
      if (key && ui[locale]?.[key]) {
        el.textContent = ui[locale][key];
      }
    });

    // Update input/textarea placeholders
    const placeholderEls = document.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>(
      '#contact [data-i18n-placeholder]',
    );
    placeholderEls.forEach((el) => {
      const key = el.dataset.i18nPlaceholder as keyof (typeof ui)['es'];
      if (key && ui[locale]?.[key]) {
        el.placeholder = ui[locale][key];
      }
    });
  }

  // Netlify Forms — AJAX submit with inline feedback
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  if (form) {
    const status = document.getElementById('form-status') as HTMLElement;
    const submitBtn = document.getElementById('contact-submit') as HTMLButtonElement;
    const submitText = submitBtn?.querySelector('.submit-text') as HTMLElement;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const locale = (document.documentElement.lang || 'es') as Locale;

      submitBtn.disabled = true;
      if (submitText) submitText.textContent = ui[locale]['contact.form.sending'];
      status.classList.add('hidden');
      status.classList.remove('is-success', 'is-error');

      try {
        const data = new FormData(form);
        const res = await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams(data as any).toString(),
        });
        if (!res.ok) throw new Error('submit failed');

        status.textContent = ui[locale]['contact.form.success'];
        status.classList.add('is-success');
        status.classList.remove('hidden');
        form.reset();
      } catch {
        status.textContent = ui[locale]['contact.form.error'];
        status.classList.add('is-error');
        status.classList.remove('hidden');
      } finally {
        submitBtn.disabled = false;
        if (submitText) submitText.textContent = ui[locale]['contact.form.send'];
      }
    });
  }

  // Copy email to clipboard
  const copyBtn = document.getElementById('copy-email-btn');
  if (copyBtn) {
    const email = copyBtn.dataset.email || '';
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(email);
      } catch {
        window.prompt('Copy this email address:', email);
        return;
      }
      const text = copyBtn.querySelector('.btn-text') as HTMLElement;
      const iconMail = copyBtn.querySelector('.icon-mail') as HTMLElement;
      const iconCheck = copyBtn.querySelector('.icon-check') as HTMLElement;
      const locale = (document.documentElement.lang || 'es') as Locale;

      if (text) text.textContent = ui[locale]['contact.copied'];
      if (iconMail) iconMail.classList.add('hidden');
      if (iconCheck) iconCheck.classList.remove('hidden');

      setTimeout(() => {
        if (text) text.textContent = email;
        if (iconMail) iconMail.classList.remove('hidden');
        if (iconCheck) iconCheck.classList.add('hidden');
      }, 2000);
    });
  }

  const initialLocale = (document.documentElement.lang || 'es') as Locale;
  updateContactLocale(initialLocale);

  window.addEventListener('locale-change', ((e: CustomEvent<Locale>) => {
    updateContactLocale(e.detail);
  }) as EventListener);
</script>
