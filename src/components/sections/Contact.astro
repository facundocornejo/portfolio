---
---

<section id="contact" class="pt-16 sm:pt-20 pb-20 px-4 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-3xl reach-wrap scroll-fade">
    <h2 class="reach-heading">
      <span data-locale-es>Encontrame.</span>
      <span data-locale-en class="hidden">Find me.</span>
    </h2>

    <p class="reach-mail">
      <a href="mailto:facundocornejodediego@gmail.com">facundocornejodediego@gmail.com</a>
      <button
        type="button"
        class="reach-copy"
        id="copy-email-btn"
        data-email="facundocornejodediego@gmail.com"
      >
        <span class="btn-text" data-i18n-key="contact.copy">copiar</span>
      </button>
    </p>

    <p class="reach-links">
      <a href="https://github.com/facundocornejo" target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href="https://www.linkedin.com/in/facundocornejo/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
      <a href="/resume">
        <span data-locale-es>Currículum</span>
        <span data-locale-en class="hidden">Resume</span>
      </a>
    </p>

    <p class="reach-place">
      <span data-locale-es>Remoto · Ciudadanía UE · Respondo en menos de 24 h.</span>
      <span data-locale-en class="hidden">Remote · EU citizenship · I reply within 24 h.</span>
    </p>

    {/* Contact form (Netlify Forms) */}
    <form
      name="contacto"
      method="POST"
      data-netlify="true"
      netlify-honeypot="bot-field"
      id="contact-form"
      class="contact-form"
    >
      <input type="hidden" name="form-name" value="contacto" />
      {/* Honeypot field — hidden from humans */}
      <p class="hidden" aria-hidden="true">
        <label>No llenar: <input name="bot-field" /></label>
      </p>

      <p class="form-lead">
        <span data-locale-es>¿O preferís escribirme directo desde acá?</span>
        <span data-locale-en class="hidden">Or write to me right from here:</span>
      </p>

      <div class="form-field">
        <label for="cf-name" class="form-label" data-i18n-key="contact.form.name">Nombre</label>
        <input
          type="text"
          name="name"
          id="cf-name"
          required
          autocomplete="name"
          class="form-input"
          data-i18n-placeholder="contact.form.name"
          placeholder="Nombre"
        />
      </div>

      <div class="form-field">
        <label for="cf-email" class="form-label" data-i18n-key="contact.form.email">Email</label>
        <input
          type="email"
          name="email"
          id="cf-email"
          required
          autocomplete="email"
          class="form-input"
          placeholder="tu@email.com"
        />
      </div>

      <div class="form-field">
        <label for="cf-message" class="form-label" data-i18n-key="contact.form.message">Mensaje</label>
        <textarea
          name="message"
          id="cf-message"
          required
          rows="5"
          class="form-input"
          data-i18n-placeholder="contact.form.message"
          placeholder="Mensaje"
        ></textarea>
      </div>

      <button type="submit" class="btn-primary contact-submit" id="contact-submit">
        <span class="submit-text" data-i18n-key="contact.form.send">Enviar mensaje</span>
      </button>

      <p class="form-status hidden" id="form-status" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

<style>
  .reach-wrap {
    border-top: 1px solid var(--color-border);
    padding-top: 2.5rem;
  }

  .reach-heading {
    font-size: 1.5rem;
    font-style: italic;
    font-weight: 600;
    color: var(--color-accent);
    margin-bottom: 0.875rem;
  }

  .reach-mail {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem;
  }

  .reach-mail a {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 3.4vw, 1.875rem);
    font-weight: 600;
    color: var(--color-text-primary);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-accent) 55%, transparent);
    text-underline-offset: 4px;
    word-break: break-all;
  }

  .reach-mail a:hover {
    color: var(--color-accent);
  }

  .reach-copy {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    border-radius: 0.375rem;
    padding: 0.25rem 0.625rem;
    background: none;
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .reach-copy:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .reach-links {
    margin-top: 0.875rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem 1.375rem;
    font-size: 0.9375rem;
  }

  .reach-links a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: color-mix(in srgb, var(--color-accent) 45%, transparent);
  }

  .reach-links a:hover {
    text-decoration-color: var(--color-accent);
  }

  .reach-place {
    margin-top: 0.625rem;
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  /* ---- Formulario ---- */
  .contact-form {
    margin-top: 2.25rem;
    display: flex;
    flex-direction: column;
    gap: 1.125rem;
    max-width: 34rem;
  }

  .form-lead {
    color: var(--color-text-secondary);
    font-size: 0.9375rem;
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .form-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
  }

  .form-input {
    width: 100%;
    padding: 0.75rem 1rem;
    border-radius: 0.5rem;
    border: 1px solid var(--color-border);
    background-color: var(--color-bg-card);
    color: var(--color-text-primary);
    font-size: 1rem;
    font-family: inherit;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .form-input::placeholder {
    color: var(--color-text-muted);
  }

  .form-input:focus {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-accent) 30%, transparent);
  }

  textarea.form-input {
    resize: vertical;
    min-height: 7rem;
  }

  /* Geometria y colores de .btn-primary (global). */
  .contact-submit {
    align-self: flex-start;
    cursor: pointer;
  }

  .contact-submit:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
  }

  .form-status {
    font-size: 0.875rem;
  }

  .form-status.is-success {
    color: var(--color-accent);
  }

  .form-status.is-error {
    color: var(--color-error);
  }
</style>

<script>
  import type { Locale } from '@i18n/store';
  import { ui } from '@i18n/ui';

  function updateContactLocale(locale: Locale) {
    const esElements = document.querySelectorAll<HTMLElement>('#contact [data-locale-es]');
    const enElements = document.querySelectorAll<HTMLElement>('#contact [data-locale-en]');

    if (locale === 'en') {
      esElements.forEach((el) => el.classList.add('hidden'));
      enElements.forEach((el) => el.classList.remove('hidden'));
    } else {
      esElements.forEach((el) => el.classList.remove('hidden'));
      enElements.forEach((el) => el.classList.add('hidden'));
    }

    const i18nElements = document.querySelectorAll<HTMLElement>('#contact [data-i18n-key]');
    i18nElements.forEach((el) => {
      const key = el.dataset.i18nKey as keyof (typeof ui)['es'];
      if (key && ui[locale]?.[key]) {
        el.textContent = ui[locale][key];
      }
    });

    // Update input/textarea placeholders
    const placeholderEls = document.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>(
      '#contact [data-i18n-placeholder]',
    );
    placeholderEls.forEach((el) => {
      const key = el.dataset.i18nPlaceholder as keyof (typeof ui)['es'];
      if (key && ui[locale]?.[key]) {
        el.placeholder = ui[locale][key];
      }
    });
  }

  // Netlify Forms — AJAX submit with inline feedback
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  if (form) {
    const status = document.getElementById('form-status') as HTMLElement;
    const submitBtn = document.getElementById('contact-submit') as HTMLButtonElement;
    const submitText = submitBtn?.querySelector('.submit-text') as HTMLElement;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const locale = (document.documentElement.lang || 'es') as Locale;

      submitBtn.disabled = true;
      if (submitText) submitText.textContent = ui[locale]['contact.form.sending'];
      status.classList.add('hidden');
      status.classList.remove('is-success', 'is-error');

      try {
        const data = new FormData(form);
        const res = await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams(data as any).toString(),
        });
        if (!res.ok) throw new Error('submit failed');

        status.textContent = ui[locale]['contact.form.success'];
        status.classList.add('is-success');
        status.classList.remove('hidden');
        form.reset();
      } catch {
        status.textContent = ui[locale]['contact.form.error'];
        status.classList.add('is-error');
        status.classList.remove('hidden');
      } finally {
        submitBtn.disabled = false;
        if (submitText) submitText.textContent = ui[locale]['contact.form.send'];
      }
    });
  }

  // Copy email to clipboard
  const copyBtn = document.getElementById('copy-email-btn');
  if (copyBtn) {
    const email = copyBtn.dataset.email || '';
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(email);
      } catch {
        window.prompt('Copy this email address:', email);
        return;
      }
      const text = copyBtn.querySelector('.btn-text') as HTMLElement;
      const locale = (document.documentElement.lang || 'es') as Locale;

      if (text) text.textContent = ui[locale]['contact.copied'];

      setTimeout(() => {
        if (text) text.textContent = ui[locale]['contact.copy'];
      }, 2000);
    });
  }

  const initialLocale = (document.documentElement.lang || 'es') as Locale;
  updateContactLocale(initialLocale);

  window.addEventListener('locale-change', ((e: CustomEvent<Locale>) => {
    updateContactLocale(e.detail);
  }) as EventListener);
</script>
