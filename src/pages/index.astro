---
import Layout from '@layouts/Layout.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import Hero from '@components/sections/Hero.astro';
import Projects from '@components/sections/Projects.astro';
import About from '@components/sections/About.astro';
import Workflow from '@components/sections/Workflow.astro';
import Contact from '@components/sections/Contact.astro';
---

<Layout
  title="Facundo Cornejo — Fullstack Developer | React, Next.js, Angular"
  description="Portfolio de Facundo Cornejo — Fullstack Developer de Paraná, Argentina. React, Next.js, TypeScript, AI-augmented workflow. Ciudadanía UE."
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: 'Facundo Cornejo',
      jobTitle: 'Fullstack Developer',
      url: 'https://fromdevdiego.com',
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Paraná',
        addressCountry: 'AR',
      },
      sameAs: [
        'https://github.com/facundocornejo',
        'https://www.linkedin.com/in/facundo-cornejo-12a58b325/',
      ],
    })}
  />
  <Header />
  <main class="pt-16">
    <Hero />
    <Projects />
    <About />
    <Workflow />
    <Contact />
  </main>
  <Footer />
</Layout>
